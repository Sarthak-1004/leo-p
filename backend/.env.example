NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://kanan:local-development-only@127.0.0.1:55432/kanan
# Set a separate owner connection for deployment migrations when DATABASE_URL
# uses a restricted runtime role. Never expose either connection to the frontend.
MIGRATION_DATABASE_URL=
SESSION_HOURS=12
ACCESS_TIMEZONE=Asia/Kolkata
# Separate key for encrypted PostgreSQL archives. Keep it outside the archives.
BACKUP_ENCRYPTION_KEY=
# Set these before running db:seed; no production account has a default password.
BOOTSTRAP_ADMIN_ID=admin
BOOTSTRAP_ADMIN_NAME=Kanan Admin
BOOTSTRAP_ADMIN_PASSWORD=
# Optional S3-compatible provider. Keep the bucket private.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=kanan-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional Writing AI. Select a supported structured-output model in your account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Writing AI provider: openai (above) or vertex (Gemini on Google Cloud; the server's service account
# needs roles/aiplatform.user and no key is stored). Example: AI_PROVIDER=vertex, VERTEX_MODEL=gemini-3.7-flash
AI_PROVIDER=openai
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=
# Proxy hops in front of the API (count or address list); unset trusts none. Live: 2 (Vercel, Cloud Run).
TRUST_PROXY=
# inline (API + evaluation worker), off (API only) or only (worker with health/metrics routes only).
WORKER_MODE=inline
WORKER_CONCURRENCY=2
# At least 24 characters; enables /api/metrics for "Authorization: Bearer <token>". Empty disables it.
METRICS_TOKEN=
# Per-user write requests per minute, held in memory per instance.
ACTION_LIMIT_PER_MINUTE=300
