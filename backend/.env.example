NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://kanan:local-development-only@127.0.0.1:55432/kanan
# Set a separate owner connection for deployment migrations when DATABASE_URL
# uses a restricted runtime role. Never expose either connection to the frontend.
MIGRATION_DATABASE_URL=
SESSION_HOURS=12
ACCESS_TIMEZONE=Asia/Kolkata
# Separate key for encrypted PostgreSQL archives. Keep it outside the archives.
BACKUP_ENCRYPTION_KEY=
# Set these before running db:seed; no production account has a default password.
BOOTSTRAP_ADMIN_ID=admin
BOOTSTRAP_ADMIN_NAME=Kanan Admin
BOOTSTRAP_ADMIN_PASSWORD=
# Optional S3-compatible provider. Keep the bucket private.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=kanan-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional Writing AI. Select a supported structured-output model in your account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
