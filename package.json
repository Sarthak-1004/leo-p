{
  "name": "kanan-ielts-portal",
  "private": true,
  "scripts": {
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "db:local": "npm --prefix backend run db:local",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "build:vercel": "node scripts/build-vercel.mjs",
    "test:deployment": "node --test scripts/build-vercel.test.mjs"
  },
  "engines": {
    "node": "24.x"
  }
}
